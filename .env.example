APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres is REQUIRED, not a preference. The pgvector migrations are
# guarded by DB::getDriverName() === 'pgsql' and silently no-op on any
# other driver, so sqlite produces a schema with no embedding column, no
# HNSW index, and a chatbot that can never retrieve anything — with no
# error to explain why. Use Supabase's transaction pooler (port 6543).
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# Session + cache drivers are the biggest per-request cost after the
# queries themselves: with 'database', EVERY page view does a session read
# and a session write against the remote Supabase database before any page
# query runs.
#   Local dev:  SESSION_DRIVER=file, CACHE_STORE=file (no network at all).
#   Vercel:     'file' does not work (each function instance has its own
#               /tmp, and ChatQuota needs a cache shared across them). Use
#               Redis — e.g. a free Upstash database — with
#               SESSION_DRIVER=redis, CACHE_STORE=redis, REDIS_CLIENT=predis
#               (pure PHP, no extension needed) and REDIS_URL=rediss://...
#               Leave both on 'database' until Redis is set up.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Supabase Storage (S3-compatible) — generate the access key pair from:
# Supabase Dashboard > Project Settings > Storage > S3 Connection.
# RESEARCH_FILES_DISK stays 'local' (config/research.php default) until
# these are filled in and verified — the app deploys to Vercel (see
# vercel.json), whose filesystem is read-only/ephemeral outside /tmp, so
# 'local' silently loses every uploaded file in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# RESEARCH_FILES_DISK=s3

# Bump to force every research document to be re-embedded (e.g. after
# changing OPENAI_EMBEDDING_MODEL or a ChunkingService change that alters
# chunk boundaries) — see config/research.php's 'embedding' block and
# php artisan research:index-backfill.
RESEARCH_EMBEDDING_VERSION=1

# REQUIRED for every AI feature: document/query embeddings, the chatbot's
# answers, and the submission form's keyword/SDG suggestions. Without it
# research is never indexed and the chatbot cannot answer anything.
OPENAI_API_KEY=
OPENAI_METADATA_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Per-student daily cap on submission-form AI calls (abstract drafts +
# keyword/SDG suggestions). Cached results don't count against it.
RESEARCH_AI_PER_DAY=10

# Index each submission inline (->afterResponse()) instead of via the
# database queue. REQUIRED on Vercel and anywhere else without a running
# `php artisan queue:work` — otherwise ProcessResearchDocument is queued
# and never runs, leaving every submission unsearchable while appearing to
# succeed. See config/research.php.
RESEARCH_INDEX_SYNC=true

# Shared secret for POST /internal/queue/drain — the serverless safety net
# for jobs too large to finish inline. Generate with: php artisan key:generate --show
# Leave empty and the route 404s (fails closed).
RESEARCH_CRON_SECRET=

# AI chatbot (RAG) — see config/chat.php for what each of these tunes.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_MAX_OUTPUT_TOKENS=700
CHAT_RATE_PER_MINUTE=6
CHAT_RATE_PER_DAY=50

# Retrieval tiers. An ordinary question is answered from a study's abstract
# rather than its body text, and escalates to full text only when the
# question needs specifics (see App\Services\Retrieval\RetrievalTierPlanner).
# The output ceiling is the biggest cost lever here: gpt-4o-mini bills output
# at 4x input, so an abstract-level answer capped at 350 tokens saves more
# than any prompt-side trimming.
CHAT_TIER_ABSTRACT_OUTPUT_TOKENS=350
CHAT_TIER_ABSTRACT_EVIDENCE_TOKENS=1200

# External open-access literature (OpenAlex) — metadata only: titles,
# abstracts and DOIs, never full text, nothing embedded, nothing stored as a
# corpus. Lets the bot point at published research this repository does NOT
# hold, kept rigorously separate from its own studies ([E1] citations, their
# own response key, their own UI list).
#
# OFF by default, and the null driver makes "off" genuinely inert — no
# outbound call is made at all. A student records system calling out on a
# user's question should be a deployment decision.
#
# EXTERNAL_LITERATURE_MAILTO is OpenAlex's politeness convention: giving them
# a contact address puts you in their faster pool and means they can reach a
# human before blocking a misbehaving client. Set it if you enable this.
EXTERNAL_LITERATURE_ENABLED=false
EXTERNAL_LITERATURE_DRIVER=null
EXTERNAL_LITERATURE_MAILTO=

# Cost reporting. USD is what OpenAI bills; this rate is only for the
# optional --peso column on `php artisan research:ai-cost`.
AI_PHP_PER_USD=58

VITE_APP_NAME="${APP_NAME}"
