APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Supabase Storage (S3-compatible) — generate the access key pair from:
# Supabase Dashboard > Project Settings > Storage > S3 Connection.
# RESEARCH_FILES_DISK stays 'local' (config/research.php default) until
# these are filled in and verified — the app deploys to Vercel (see
# vercel.json), whose filesystem is read-only/ephemeral outside /tmp, so
# 'local' silently loses every uploaded file in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# RESEARCH_FILES_DISK=s3

# Bump to force every research document to be re-embedded (e.g. after
# changing OPENAI_EMBEDDING_MODEL or a ChunkingService change that alters
# chunk boundaries) — see config/research.php's 'embedding' block and
# php artisan research:index-backfill.
RESEARCH_EMBEDDING_VERSION=1

# AI chatbot (RAG) — see config/chat.php for what each of these tunes.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_MAX_OUTPUT_TOKENS=700
CHAT_RATE_PER_MINUTE=6
CHAT_RATE_PER_DAY=50

VITE_APP_NAME="${APP_NAME}"
